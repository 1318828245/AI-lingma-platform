# 复制为 .env.production；此文件绝不提交。
POSTGRES_DB=ai_lingma
POSTGRES_USER=ai_lingma
POSTGRES_PASSWORD=replace-with-a-long-random-password

AI_LINGMA_ENVIRONMENT=production
AI_LINGMA_DEBUG=false
AI_LINGMA_JWT_SECRET=replace-with-at-least-32-random-characters
AI_LINGMA_ADMIN_USERNAME=admin
AI_LINGMA_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AI_LINGMA_ADMIN_EMAIL=admin@example.com
AI_LINGMA_REGISTER_ENABLED=false
AI_LINGMA_CORS_ORIGINS=["https://app.example.com"]

# 填入 API Key 前始终处于 mock；真实生成仅需改 model、填入 key。
# DeepSeek OpenAI 兼容端点：https://api.deepseek.com
AI_LINGMA_BUILD_MODE=mock
AI_LINGMA_COMMAND_MODE=sandbox
AI_LINGMA_LLM_MODEL=mock
AI_LINGMA_LLM_BASE_URL=https://api.deepseek.com
AI_LINGMA_LLM_API_KEY=

# Qwen 视觉模型：生成完成后的截图质量评估，可选但推荐配置
AI_LINGMA_EVAL_VISION_PROVIDER=qwen_compatible
AI_LINGMA_EVAL_VISION_MODEL=qwen3-vl-flash
AI_LINGMA_EVAL_VISION_BASE_URL=
AI_LINGMA_EVAL_VISION_API_KEY=
AI_LINGMA_EVAL_VISION_TIMEOUT_SECONDS=90
AI_LINGMA_EVAL_VISION_THINKING_ENABLED=false

# 外部素材来源（可选；不使用时留空）
AI_LINGMA_ASSET_PEXELS_API_KEY=
AI_LINGMA_ASSET_PIXABAY_API_KEY=
AI_LINGMA_ASSET_UNSPLASH_ACCESS_KEY=
AI_LINGMA_ASSET_CONCURRENCY=2

# 2 核 4G 服务器的保守并发/超时配置
AI_LINGMA_GENERATION_CONCURRENCY=1
AI_LINGMA_MODIFICATION_CONCURRENCY=1
AI_LINGMA_TASK_TIMEOUT_SECONDS=1200
AI_LINGMA_MAX_REQUIREMENT_LENGTH=8000

# 宿主机目录；必须由 deploy:deploy 拥有且不应位于代码仓库中。
AI_LINGMA_DATA_DIR=/srv/ai-lingma-data
AI_LINGMA_HTTP_PORT=8080
# 执行 `id -u deploy`、`id -g deploy` 后填入；当前服务器通常为 1002。
AI_LINGMA_RUNTIME_UID=1002
AI_LINGMA_RUNTIME_GID=1002
