# AI-Lingma-Platform backend environment
AI_LINGMA_ENVIRONMENT=dev
AI_LINGMA_DEBUG=true

# 留空则使用默认值：<repo>/storage/app.db
AI_LINGMA_DATABASE_URL=
AI_LINGMA_STORAGE_DIR=

# 生产环境必须修改
AI_LINGMA_JWT_SECRET=change-me-in-production
AI_LINGMA_ACCESS_TOKEN_EXPIRE_MINUTES=60
AI_LINGMA_REFRESH_TOKEN_EXPIRE_DAYS=7

# 开放注册开关（P0 默认关闭，仅内置管理员）
AI_LINGMA_REGISTER_ENABLED=false

# 内置管理员（初始化脚本使用）
AI_LINGMA_ADMIN_USERNAME=admin
AI_LINGMA_ADMIN_PASSWORD=admin123
AI_LINGMA_ADMIN_EMAIL=admin@example.com

# 新用户默认生成配额
AI_LINGMA_DEFAULT_USER_QUOTA=20

# 生成工作流（M1-2）
# build_mode: real（真实 npm 构建/语法检查）| mock（离线模拟构建）
AI_LINGMA_BUILD_MODE=real
AI_LINGMA_GENERATION_CONCURRENCY=2
AI_LINGMA_MODIFICATION_CONCURRENCY=4
AI_LINGMA_TASK_TIMEOUT_SECONDS=1200
AI_LINGMA_MAX_REQUIREMENT_LENGTH=8000
AI_LINGMA_MOCK_DELAY_SECONDS=0.05

# LLM（OpenAI 兼容协议；base_url 留空则使用内置 mock 执行器）
AI_LINGMA_LLM_MODEL=mock
AI_LINGMA_LLM_BASE_URL=
AI_LINGMA_LLM_API_KEY=
AI_LINGMA_LLM_REASONING_EFFORT=high
AI_LINGMA_LLM_THINKING_ENABLED=true

# 生成 Agent 最大工具调用轮次
AI_LINGMA_AGENT_MAX_ITERATIONS=50

# 素材来源：密钥仅由后端白名单适配器使用，绝不可暴露给模型或前端。
# Pexels 用于照片；Pixabay 还支持插画/矢量；Unsplash 为高质量照片备用来源。
AI_LINGMA_ASSET_PEXELS_API_KEY=
AI_LINGMA_ASSET_PIXABAY_API_KEY=
AI_LINGMA_ASSET_UNSPLASH_ACCESS_KEY=
AI_LINGMA_ASSET_CONCURRENCY=3

# 命令执行模式：shell（本机终端语义，本地开发）| sandbox（白名单受限）| docker（受限容器，生产）
AI_LINGMA_COMMAND_MODE=shell

# M6-1 Docker 沙箱。docker 模式默认禁用容器网络；请先构建 backend/docker/sandbox/Dockerfile
# 并通过预构建镜像或受控离线 npm 缓存准备构建依赖，不能依赖容器运行时联网下载。
AI_LINGMA_DOCKER_BINARY=docker
AI_LINGMA_DOCKER_IMAGE=ai-lingma-sandbox:node20
AI_LINGMA_DOCKER_NETWORK=none
AI_LINGMA_DOCKER_WORKSPACE_PATH=/workspace
AI_LINGMA_DOCKER_USER=sandbox
AI_LINGMA_DOCKER_MEMORY_LIMIT=768m
AI_LINGMA_DOCKER_CPU_LIMIT=1.0
AI_LINGMA_DOCKER_PIDS_LIMIT=256
AI_LINGMA_DOCKER_TMPFS_SIZE=128m

# 首页项目截图（无头 Edge/Chrome）
AI_LINGMA_BACKEND_URL=http://127.0.0.1:8000
AI_LINGMA_SCREENSHOT_TIMEOUT_SECONDS=45
